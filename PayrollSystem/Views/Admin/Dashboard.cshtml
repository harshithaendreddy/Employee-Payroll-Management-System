@{
    ViewData["Title"] = "Admin Dashboard";
}
<div style="background-image: url('/images/background.png'); background-size: cover; background-position: center; height: 100vh; padding: 20px;">

<h2>Admin Dashboard</h2>

<p>Welcome, Admin! Here you can manage employee records and update absence details.</p>

<!-- You can add links for Admin actions, such as managing employees, viewing reports, etc. -->
<div>
    <a href="@Url.Action("ManageEmployees", "Admin")" class="btn btn-outline-info">Manage Employees</a>
    <a href="@Url.Action("ManageAbsentees", "Admin")" class="btn btn-outline-warning">Manage Absentees</a>

</div>
</div>
