@model dynamic

<h2>Employee Payslip</h2>

<table class="table">
    <tr>
        <th>Employee ID</th>
        <td>@Model.EmployeeId</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Username</th>
        <td>@Model.Username</td>
    </tr>
    <tr>
        <th>Role</th>
        <td>@Model.Role</td>
    </tr>
    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>
    <tr>
        <th>Net Salary</th>
        <td>@Model.NetSalary</td>
    </tr>
</table>
